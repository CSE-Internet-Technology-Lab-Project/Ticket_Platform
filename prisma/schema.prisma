// ============================================================
// GENERATOR & DATASOURCE
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  USER
  ORGANIZER
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventType {
  MOVIE
  CONCERT
  THEATER
  SPORTS
  COMEDY
  CONFERENCE
  OTHER
}

enum SeatType {
  REGULAR
  PREMIUM
  VIP
}

enum InventoryStatus {
  AVAILABLE
  HELD
  SOLD
  BLOCKED
}

enum ReservationStatus {
  ACTIVE
  EXPIRED
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentAttemptStatus {
  INITIATED
  PROCESSING
  SUCCESS
  FAILED
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum PricingRuleType {
  INVENTORY
  DEMAND
  TIME
  WEEKEND
  EARLY_BIRD
  LAST_MINUTE
}

enum PricingAdjustmentType {
  PERCENTAGE
  FIXED_AMOUNT
  MULTIPLIER
}

enum NotificationType {
  BOOKING_CONFIRMED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  RESERVATION_EXPIRING
  RESERVATION_EXPIRED
  EVENT_CANCELLED
  EVENT_RESCHEDULED
  REFUND_SUCCESS
  TICKET_USED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGOUT

  EVENT_CREATED
  EVENT_UPDATED
  EVENT_CANCELLED

  TICKET_RESERVED
  RESERVATION_EXPIRED

  ORDER_CREATED
  ORDER_CONFIRMED
  ORDER_CANCELLED

  PAYMENT_INITIATED
  PAYMENT_SUCCESS
  PAYMENT_FAILED

  REFUND_INITIATED
  REFUND_SUCCESS

  TICKET_ISSUED
  TICKET_USED
}

// ============================================================
// USER
// ============================================================

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)

  venues        Venue[]
  events        Event[]
  reservations  Reservation[]
  orders        Order[]
  notifications Notification[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
}

// ============================================================
// VENUE
// ============================================================

model Venue {
  id          String @id @default(uuid())
  createdById String

  name     String
  address  String
  city     String
  capacity Int

  createdBy User @relation(fields: [createdById], references: [id])

  sections VenueSection[]
  events   Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([city])
}

// ============================================================
// VENUE SECTION
// ============================================================

model VenueSection {
  id      String @id @default(uuid())
  venueId String

  name     String
  capacity Int

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  seats Seat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, name])
  @@index([venueId])
}

// ============================================================
// SEAT
// ============================================================

model Seat {
  id        String @id @default(uuid())
  sectionId String

  rowNumber  Int
  seatNumber Int
  seatType   SeatType @default(REGULAR)

  section VenueSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  inventories TicketInventory[]

  createdAt DateTime @default(now())

  @@unique([sectionId, rowNumber, seatNumber])
  @@index([sectionId])
}

// ============================================================
// EVENT
// ============================================================

model Event {
  id          String @id @default(uuid())
  organizerId String
  venueId     String

  name        String
  description String?
  type        EventType
  startTime   DateTime
  endTime     DateTime
  status      EventStatus @default(DRAFT)

  organizer User @relation(fields: [organizerId], references: [id])

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  ticketTypes  TicketType[]
  inventories  TicketInventory[]
  reservations Reservation[]
  orders       Order[]

  pricingPolicy PricingPolicy?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizerId])
  @@index([venueId])
  @@index([status])
  @@index([type])
  @@index([startTime])
}

// ============================================================
// TICKET TYPE
// ============================================================

model TicketType {
  id      String @id @default(uuid())
  eventId String

  name        String
  description String?

  basePrice Decimal @db.Decimal(10, 2)
  quantity  Int

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  inventories  TicketInventory[]
  pricingRules PricingRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, name])
  @@index([eventId])
}

// ============================================================
// TICKET INVENTORY
// ============================================================

model TicketInventory {
  id           String @id @default(uuid())
  eventId      String
  seatId       String
  ticketTypeId String

  currentPrice Decimal @db.Decimal(10, 2)

  status  InventoryStatus @default(AVAILABLE)
  version Int             @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  seat Seat @relation(fields: [seatId], references: [id])

  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  reservationItems ReservationItem[]
  orderItems       OrderItem[]

  ticket Ticket?

  priceHistory TicketPriceHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, seatId])
  @@index([eventId, status])
  @@index([ticketTypeId])
  @@index([seatId])
}

// ============================================================
// RESERVATION
// ============================================================

model Reservation {
  id      String @id @default(uuid())
  userId  String
  eventId String

  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id])

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  items ReservationItem[]

  order Order?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([eventId])
  @@index([expiresAt])
  @@index([status])
}

// ============================================================
// RESERVATION ITEM
// ============================================================

model ReservationItem {
  id                String @id @default(uuid())
  reservationId     String
  ticketInventoryId String

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  ticketInventory TicketInventory @relation(fields: [ticketInventoryId], references: [id])

  createdAt DateTime @default(now())

  @@unique([reservationId, ticketInventoryId])
  @@index([ticketInventoryId])
}

// ============================================================
// ORDER
// ============================================================

model Order {
  id            String  @id @default(uuid())
  userId        String
  eventId       String
  reservationId String? @unique

  totalAmount Decimal @db.Decimal(10, 2)
  currency    String  @default("INR")

  status OrderStatus @default(PENDING)

  user User @relation(fields: [userId], references: [id])

  event Event @relation(fields: [eventId], references: [id])

  reservation Reservation? @relation(fields: [reservationId], references: [id])

  items OrderItem[]

  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([eventId])
  @@index([status])
}

// ============================================================
// ORDER ITEM
// ============================================================

model OrderItem {
  id                String @id @default(uuid())
  orderId           String
  ticketInventoryId String

  // Immutable price paid by the customer
  unitPrice Decimal @db.Decimal(10, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  ticketInventory TicketInventory @relation(fields: [ticketInventoryId], references: [id])

  ticket Ticket?

  createdAt DateTime @default(now())

  @@unique([orderId, ticketInventoryId])
  @@index([ticketInventoryId])
}

// ============================================================
// TICKET
// ============================================================

model Ticket {
  id                String @id @default(uuid())
  orderItemId       String @unique
  ticketInventoryId String @unique

  ticketCode String @unique

  status TicketStatus @default(ACTIVE)

  issuedAt DateTime  @default(now())
  usedAt   DateTime?

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  ticketInventory TicketInventory @relation(fields: [ticketInventoryId], references: [id])

  @@index([status])
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id      String @id @default(uuid())
  orderId String @unique

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("INR")

  status PaymentStatus @default(PENDING)

  provider      String?
  transactionId String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  attempts PaymentAttempt[]
  refunds  Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([transactionId])
}

// ============================================================
// PAYMENT ATTEMPT
// ============================================================

model PaymentAttempt {
  id        String @id @default(uuid())
  paymentId String

  idempotencyKey String @unique

  status PaymentAttemptStatus @default(INITIATED)

  providerTransactionId String?
  failureReason         String?

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("INR")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([providerTransactionId])
}

// ============================================================
// PAYMENT WEBHOOK
// ============================================================

model PaymentWebhook {
  id String @id @default(uuid())

  provider String
  eventId  String

  payload Json

  processed   Boolean   @default(false)
  processedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([processed])
}

// ============================================================
// REFUND
// ============================================================

model Refund {
  id        String @id @default(uuid())
  paymentId String

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("INR")

  status RefundStatus @default(PENDING)

  reason String?

  providerRefundId String?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
  @@index([providerRefundId])
}

// ============================================================
// PRICING POLICY
// ============================================================

model PricingPolicy {
  id      String @id @default(uuid())
  eventId String @unique

  enabled Boolean @default(true)

  minimumPrice Decimal? @db.Decimal(10, 2)
  maximumPrice Decimal? @db.Decimal(10, 2)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  rules PricingRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// PRICING RULE
// ============================================================

model PricingRule {
  id       String @id @default(uuid())
  policyId String

  // Optional: rule can apply to a specific ticket type
  ticketTypeId String?

  name String

  type            PricingRuleType
  adjustmentType  PricingAdjustmentType
  adjustmentValue Decimal               @db.Decimal(10, 2)

  // Flexible conditions, e.g.
  // {
  //   "remainingPercentage": 20,
  //   "daysBeforeEvent": 3
  // }
  conditions Json?

  priority Int     @default(0)
  enabled  Boolean @default(true)

  policy PricingPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  ticketType TicketType? @relation(fields: [ticketTypeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([policyId, enabled])
  @@index([ticketTypeId])
  @@index([priority])
}

// ============================================================
// TICKET PRICE HISTORY
// ============================================================

model TicketPriceHistory {
  id                String @id @default(uuid())
  ticketInventoryId String

  price  Decimal @db.Decimal(10, 2)
  reason String

  ticketInventory TicketInventory @relation(fields: [ticketInventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ticketInventoryId])
  @@index([createdAt])
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id     String @id @default(uuid())
  userId String

  type    NotificationType
  title   String
  message String

  status NotificationStatus @default(PENDING)
  sentAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// OUTBOX EVENT
// ============================================================

model OutboxEvent {
  id String @id @default(uuid())

  eventType     String
  aggregateType String
  aggregateId   String

  payload Json

  published   Boolean   @default(false)
  publishedAt DateTime?

  retryCount Int     @default(0)
  lastError  String?

  createdAt DateTime @default(now())

  @@index([published, createdAt])
  @@index([aggregateType, aggregateId])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id     String  @id @default(uuid())
  userId String?

  action     AuditAction
  entityType String
  entityId   String?

  metadata Json?

  ipAddress String?
  userAgent String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}
